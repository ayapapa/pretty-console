{
  "name": "@ayapapa-npm/pretty-console-js",
  "version": "0.1.2",
  "description": "A tiny wrapper around the standard Node.js `console`.",
  "license": "MIT",
  "author": "ayapapa",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "images"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --out-dir dist --clean --dts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:debug": "vitest --inspect-brk --run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run build && npm run test",
    "release:check": "npm run typecheck && npm run build && npm run test",
    "prepublishOnly": "npm run release:check"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@ayapapa-npm/date-formatter-js": "^0.1.1"
  }
}
